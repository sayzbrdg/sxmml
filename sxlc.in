(use sxmml)
(use gauche.parseopt)
(use gauche.package)
(use gauche.process)
(use gauche.charconv)
(use file.util)

(define (main argv)
  ;; 終了値は 0 成功、1 変換の失敗、2 使用法の誤り、3 後処理の失敗とする (#37)
  (guard (e [(<parseopt-error> e) (%usage-error (condition-message e))])
    (let-args (cdr argv)
        ([mode "m|mode=y" #f]
         [optimize "O|optimize=i" 1]
         [cmd "c|command=s" #f]
         [output "o|output=s" #f]
         [wsl "w|wsl" #f]
         [#f "l|list" => %mode-list-output]
         [#f "h|help" => (^[] (%usage 0))]
         [#f "v|version" => %version-output]
         . args)
      (when (null? args)
        (%usage-error "no source file specified"))
      ;; 入力ファイルは 1 つに限る。オプションの解析は最初の入力ファイルで止まるため、
      ;; 後ろに書いたオプションも含めて、残りの引数は使用法の誤りとする (#42)
      (unless (null? (cdr args))
        (let1 extra (cadr args)
          (%usage-error
           (string-append #"unexpected argument after the source file: ~extra"
                          (if (#/^-/ extra)
                            "\noptions must be placed before the source file"
                            "")))))
      ;; -o の指定先が入力ファイルと同じ場合は、ソースを読み込む前に使用法の誤りとする (#40)
      (when output
        (%output-file-check output (car args)))
      ;; -c の字句の誤りは、変換の前に使用法の誤りとして検出する
      (let1 cmd-args (and cmd
                          (guard (e [else (%usage-error (%error-message e))])
                            (shell-tokenize-string cmd)))
        (parameterize ([sxmml-source-file (sys-normalize-pathname (car args) :absolute #t)]
                       [sxmml-mode-fixed (boolean mode)])
          (when mode
            (%mode-select mode))
          (%convert (^[]
                      (load (sxmml-source-file))
                      (unless (sxmml-mode-get)
                        (error <sxmml-error> "backend is not specified by option or source file"))))
          (let* ([output-path (%output-file-resolve output)]
                 [prepared (%convert (^[] (make-sxmml-output-environment
                                           (sxmml-environment) :output output-path
                                           :optimize optimize :source (sxmml-source-file))))]
                 [result (%convert (^[] ((slot-ref (sxmml-mode-get) 'backend) prepared)))]
                 [actual-output (slot-ref result 'output)])
            (when actual-output
              (format #t "Translate: ~a => ~a\n" (sxmml-source-file) actual-output))
            (format #t "Processing Mode: ~a\n" (slot-ref (sxmml-mode-get) 'name))
            (format #t "Optimize level: ~d\n\n" optimize)
            (%ticks-information-output prepared (slot-ref result 'track-names))
            (if (and cmd-args actual-output)
              (%post-process cmd cmd-args wsl actual-output)
              0)))))))

;; 既知の入力エラーは簡潔に、未知の例外はGaucheの標準報告で知らせる。
(define (%convert thunk)
  (guard (e [(sxmml-error? e) (%known-error-output e) (exit 1)]
            [else (report-error e) (exit 1)])
    (thunk)))

(define (%known-error-output e)
  (format (current-error-port) "sxlc: error: ~a~a~a\n"
          (if (sxmml-source-context? e)
            (format #f "~a: " (sxmml-source-context-location e)) "")
          (condition-message e)
          (if (sxmml-track-context? e)
            (format #f " on ~a track" (sxmml-track-context-track e)) "")))

;; 出力先を決める。-o の指定、なければ入力ファイル名の拡張子を、選んだモードが
;; 登録した拡張子に替えたものとする。拡張子が登録されていなければ #f を返し、
;; ファイルを出力しないバックエンドへ渡す
(define (%output-file-resolve output)
  (rlet1 file (cond [output (sys-normalize-pathname output :absolute #t)]
                    [(slot-ref (sxmml-mode-get) 'output-extension)
                     => (cut path-swap-extension (sxmml-source-file) <>)]
                    [else #f])
    (when file
      (%output-file-check file (sxmml-source-file)))))

;; 出力先が入力ファイルと同じ場合は、ソースを上書きしないよう使用法の誤りとする (#40)。
;; 書き方の違いやシンボリックリンクを含めて、同じファイルかを判定する
(define (%output-file-check output source)
  (when (and (file-exists? output) (file-exists? source) (file-eqv? output source))
    (%usage-error #"output file is the same as the source file: ~output")))

(define (%mode-select mode)
  (unless (sxmml-mode-find mode)
    (%usage-error (format #f "undefined mode: ~a" mode)))
  (%convert (^[] (sxmml-mode-select! mode))))

;; 後処理を実行し、終了値を返す。後処理が失敗した場合は標準エラー出力に通知して 3 を返す
(define (%post-process cmd cmd-args wsl output-file)
  ;; 後処理の段階の予期しないエラーも後処理の失敗とする
  (guard (e [else (%post-failure #"failed: ~(%error-message e)")])
    (let ([output (if wsl
                     (guard (e [else (%post-failure #"failed: wslpath: ~(%error-message e)") #f])
                       (process-output->string (list "wslpath" "-aw" output-file)))
                     output-file)])
      (cond
       [output
        ;; 生成名はシェルの字句解析を通さず、末尾の一引数として渡す
        (format #t "Post process: ~a ~a\n\n" cmd (shell-escape-string output))
        (flush)
        (let1 status ((if wsl %post-run-windows %post-run) (append cmd-args (list output)))
          (newline)
          (cond [(sys-wait-signaled? status)
                 (%post-failure (format #f "killed by signal ~d" (sys-wait-termsig status)))]
                [(zero? status) 0]
                [else
                 (%post-failure (format #f "failed: exit status ~d" (sys-wait-exit-status status)))]))]
       [else 3]))))

;; 後処理を起動し、出力は sxlc の標準出力・標準エラー出力へそのまま引き継ぐ。
;; 終了状態を返す
(define (%post-run args)
  (process-exit-status (run-process args :wait #t)))

;; -w の後処理は Windows のツールとして起動し、標準エラー出力を含む出力を CP932 から
;; 変換して表示する。復号できないバイト列は置き換える (#41)。終了状態を返す
(define (%post-run-windows args)
  (let1 p (run-process args :output :pipe :redirects '((>& 2 1)))
    (for-each print (port->string-list
                     (open-input-conversion-port (process-output p) "CP932"
                                                 :illegal-output 'replace :owner? #t)))
    (process-wait p)
    (process-exit-status p)))

(define (%post-failure message)
  (format (current-error-port) "post process ~a\n" message)
  3)

;; 使用法の誤りを通知し、使用法を表示して終了値 2 で終了する
(define (%usage-error message)
  (format (current-error-port) "~a\n" message)
  (%usage 2))

(define (%error-message e)
  (if (condition? e) (condition-message e) e))

(define (%usage code)
  (display "Usage: sxlc [-whlv] [-O opt_lv] [-m mode] [-o output] [-c command] file\n\n")
  (display "Options:\n")
  (format #t "    ~12a Set the optimize level to \"opt_lv\".\n" "-O opt_lv")
  (format #t "    ~12a 0: none, 1-2: basic, 3: repeat, 4: repeat with expansion.\n" "")
  (format #t "    ~12a Set the processing to \"mode\".\n" "-m mode")
  (format #t "    ~12a Write the generated file to \"output\".\n" "-o output")
  (format #t "    ~12a Execute \"command\" as a post process.\n" "-c command")
  (format #t "    ~12a If used with the -c option, \"wslpath\" is used to convert to a Windows path.\n" "-w")
  (format #t "    ~12a Print available modes.\n" "-l")
  (format #t "    ~12a Print version.\n" "-v")
  (format #t "    ~12a Print this message.\n" "-h")
  (newline)
  (exit code))

(define (%version-output)
  (format #t "sxmml translator version ~a\n\n"
          (slot-ref (find-gauche-package-description "sxmml") 'version))
  (exit 0))

(define (%mode-list-output)
  (format #t "sxmml available modes:\n\n")
  (for-each (^[mode]
              (format #t "  ~a" (slot-ref mode 'name))
              (unless (null? (slot-ref mode 'aliases))
                (format #t " (aliases: ~a)"
                        (string-join (map symbol->string (slot-ref mode 'aliases)) ", ")))
              (newline))
            (sort (sxmml-mode-list)
                  (^[a b] (string<? (symbol->string (slot-ref a 'name))
                                   (symbol->string (slot-ref b 'name))))))
  (newline)
  (exit 0))

(define (%ticks-information-output prepared track-names)
  (let1 tracks (slot-ref prepared 'track)
    (for-each (^[name]
                (let1 track (hash-table-get tracks name)
                  (when (> (slot-ref track 'total-ticks) 0)
                    (format #t "Track ~a: total: ~a" name (slot-ref track 'total-ticks))
                    (when (slot-ref track 'loop-exists)
                      (format #t " / loop: ~a" (slot-ref track 'loop-ticks)))
                    (newline))))
              (sort track-names (^[x y] (string<? (symbol->string x) (symbol->string y)))))
    (newline)))

(define-syntax use-backend
  (er-macro-transformer
    (^[form rename id=?]
      (cons (rename 'begin)
            (library-fold 'sxmml.backend.*
                          (^[module _ result] (cons (quasirename rename `(use ,module)) result))
                          ())))))
(use-backend)

; Local Variables:
; mode: scheme
; End:
