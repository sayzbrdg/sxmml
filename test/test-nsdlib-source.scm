(use gauche.test)
(use file.util)
(use srfi.1)
(use srfi.13)
(use sxmml)
(test-start "sxmml.backend.nsdlib-source")
(use sxmml.backend.nsdlib-source)

(let1 dir (sys-mkdtemp (build-path (temporary-directory) "nsdlib"))
  (define path (build-path dir "song.nsd"))
  (define (output :optional (level 0))
    (sxmml-nsdlib-source-output (make-sxmml-output-environment (sxmml-environment)
                                     :output path :optimize level))
    (file->string path :encoding "UTF-8"))
  (define (render kind phrase :optional (setup (^[] #f)) (level 0))
    (parameterize ([sxmml-environment (make <sxmml-environment>)])
      (sxmml-track-set! 'lead :sound-source kind)
      (setup)
      (mml lead phrase)
      (output level)))
  (define (has text . snippets)
    (every (^[snippet] (boolean (string-contains text snippet))) snippets))
  (unwind-protect
      (begin
        (parameterize ([sxmml-environment (make <sxmml-environment>)])
          (define-track echo :sound-source 'pulse)
          (define-track bass :sound-source 'vrc6-saw)
          (define-track alto :sound-source 'pulse)
          (mml alto "c8") (mml echo "d8") (mml bass "e8")
          (test* "音源ごとの辞書順と空き番号" #t
                 (has (output) "#code \"nsd_vrc6.bin\"" "TR1 o4c%12\nTR2 o4d%12\nTR8 o4e%12")))
        (parameterize ([sxmml-environment (make <sxmml-environment>)])
          (define-track sub :sound-source 'vrc6-pulse)
          (define-track unused :sound-source 'opm)
          (mml unused "c")
          (let1 err (open-output-string)
            (test* "空の拡張トラックと未対応音源" '(#t #t)
                   (list (equal? (parameterize ([current-error-port err]) (output))
                                 "#timebase 24\nBGM(0){\n}\n")
                         (has (get-output-string err) "unused" "opm")))))
        (test* "非空トラックの音源未指定" (test-error <sxmml-value-error>) (render #f "c"))
        (test* "三角波の本数超過" (test-error <sxmml-value-error>)
               (render 'triangle "c" (^[] (define-track b :sound-source 'triangle) (mml b "r"))))
        (test* "FDSとVRC6の混在" (test-error <sxmml-value-error>)
               (render 'fds "r" (^[] (define-track b :sound-source 'vrc6-saw) (mml b "c"))))
        (test* "音高の補正" '(#t #t #t)
               (list (has (render 'triangle "c") "o5c")
                     (has (render 'fds "c") "#code \"nsd_fds.bin\"" "o6c")
                     (has (render 'noise "e") "o4e")))
        (test* "補正後の範囲外" (test-error <sxmml-value-error>) (render 'fds "o7c"))
        (test* "長音の末尾ゲートと明示タイ" #t
               (has (render 'pulse "q200c%384 & d8") "q200 o4c%129&c%255 & o4d%12"))
        (test* "DPCM長休符" #t (has (render 'dpcm "r%384") "r-%129 r-%255"))
        (test* "反復の入れ子・脱出・一回" #t
               (has (render 'pulse "[[c:d]1:e]2") "[ o4c%24 : o4e%24 ]2"))
        (test* "手作り反復内のL" (test-error <sxmml-value-error>)
               (render 'pulse "" (^[] (sxmml-ir-register!
                                       (list (make <sxmml-mml-repeat-start>) (make <sxmml-mml-loop>)
                                             (make <sxmml-mml-repeat-end> :value 1)) 'lead))))
        (test* "テンポ上限" #t (has (render 'pulse "t127T127" (^[] (sxmml-resolution 48))) "t127 t127"))
        (test* "テンポ範囲外" (test-error <sxmml-value-error>)
               (render 'pulse "t128" (^[] (sxmml-resolution 48))))
        (test* "設定命令" #t (has (render 'pulse "K2K*-1D8v8v*2v*-1L@2") "_2 __-1 D8 v8 )2 (1 L @2"))
        (test* "未対応音量" (test-error <sxmml-value-error>) (render 'triangle "v1"))
        (test* "ポルタメント" #t (has (render 'pulse "/{c g}8") "o4{cg}%12"))
        (test* "ポルタメントの長さ上限" (test-error <sxmml-value-error>) (render 'pulse "/{c g}%256"))
        (test* "波形の初出と再参照" #t
               (has (render 'fds "c@{sq}c@7c@{sq}d"
                            (^[] (define-waveform sq (make-list 64 0)) (define-waveform 7 (make-list 64 63))))
                    "FDSC(0){0," "FDSC(1){63," "o6c%24 @FC0 o6c%24 @FC1 o6c%24 @FC0"))
        (test* "波形名未登録" (test-error <sxmml-reference-error>) (render 'fds "@7"))
        (test* "未使用PCMを含む番号順と移調" #t
               (has (render 'dpcm "K2o4c" (^[] (define-pcm-voice s '("o4e" "s.dmc" 3 0))
                                               (define-pcm-voice k '("o4d" "k.dmc" 2 1 -1))))
                    "#OffsetPCM $C000" "n38,\"k.dmc\",2,1,-1\nn40,\"s.dmc\",3,0" "_2 o4c"))
        (test* "異名同音の競合" #t
               (guard (e [(sxmml-value-error? e) (has (condition-message e) "kick" "snare")])
                 (render 'dpcm "r" (^[] (define-pcm-voice kick '("o4c+" "a" 0 0))
                                        (define-pcm-voice snare '("o4d-" "b" 0 0)))) #f))
        (test* "PCMを使用しない曲" #f
               (string-contains (render 'pulse "c" (^[] (define-pcm-voice x '(1 25)))) "DPCM"))
        (test* "不整列の配置先" (test-error <sxmml-value-error>)
               (render 'dpcm "r" (^[] (define-pcm-voice k '("o4c" "k" 0 0)) (define-metadata offsetpcm #xd001))))
        (test* "メタデータとパスで異なる引用方法" #t
               (has (render 'dpcm "r" (^[] (define-metadata offsetpcm #xd000)
                                           (define-metadata memo '("曲\n名" "\"別名\""))
                                           (define-pcm-voice x '("o4c" "a b\\c" 1 0))))
                    "#OffsetPCM $D000" "#Text \"曲\\n名\"\n#Text \"\\\"別名\\\"\"" "\"a b\\c\""))
        (test* "同名パターンの種類別採番" #t
               (has (render 'pulse "E{x}M{x A}cE{x}" (^[] (define-envelope x '(15 (d 3) l 8 r (8 0 4)))
                                                          (define-lfo x '(l 0 2 -2))))
                    "Envelop(0){15 D3 L 8 R (8,0,4)}" "Envelop(1){L 0 2 -2}" "Ev0 Em1 o4c%24 Ev0"))
        (test* "変換失敗時の既存生成物" #t
               (let1 before (file->string path)
                 (guard (e [(sxmml-value-error? e) (equal? before (file->string path))])
                   (render 'pulse "M0Mf[Mt c8 Mf M1]2" (^[] (define-lfo 0 '(1)) (define-lfo 1 '(2)))) #f)))
        (test* "最適化レベルと出力" (render 'pulse "[c8]4")
               (render 'pulse "[c8]4" (^[] #f) 4)))
    (remove-directory* dir)))
(test-end :exit-on-failure #t)
