;;; sxmml.commandの検査
(use gauche.test)
(test-start "sxmml.command")
(use sxmml.command)
(test-module 'sxmml.command)
(use sxmml.classes)

(define (timing ctx)
  (list (slot-ref ctx 'current-ticks)
        (sort (hash-table->alist (slot-ref ctx 'ticks-statistics))
              (^[a b] (< (car a) (car b))))))
(define (value-error thunk)
  (guard (e [else (list (sxmml-value-error? e) (condition-message e))])
    (thunk)))

(test* "C01 既定音長の設定" '(#f 8)
       (let1 ctx (make <sxmml-mml-context>)
         (list (sxmml-command-default-length-set! ctx 8) (slot-ref ctx 'default-length))))
(test* "C02 オクターブの設定と移動" '(#f #f 4)
       (let1 ctx (make <sxmml-mml-context>)
         (list (sxmml-command-octave-set! ctx 5)
               (sxmml-command-octave-shift! ctx -1) (slot-ref ctx 'current-octave))))
(test* "C03 ノート移調の設定" '(#f 2)
       (let1 ctx (make <sxmml-mml-context>)
         (list (sxmml-command-note-transpose-set! ctx 2) (slot-ref ctx 'current-transpose))))
(test* "C04 明示された文脈で音高計算" '(61 5 2)
       (let1 ctx (make <sxmml-mml-context> :current-octave 5 :current-transpose 2)
         (list (sxmml-command-note-pitch ctx 0 -1)
               (slot-ref ctx 'current-octave) (slot-ref ctx 'current-transpose))))
(test* "C05 明示された分解能と付点" '(36 4)
       (let1 ctx (make <sxmml-mml-context>)
         (list (sxmml-command-note-length->ticks ctx 48 8 1) (slot-ref ctx 'default-length))))
(test* "C06 既定音長の参照" 12
       (sxmml-command-note-length->ticks (make <sxmml-mml-context> :default-length 8) 24 #f 0))
(test* "C07 音量差分の参照" '(<sxmml-mml-volume-change> 3 <sxmml-mml-volume-change> -3 3)
       (let* ([ctx (make <sxmml-mml-context> :volume-delta 3)]
              [up (sxmml-command-volume-up ctx)] [down (sxmml-command-volume-down ctx)])
         (list (class-name (class-of up)) (slot-ref up 'value)
               (class-name (class-of down)) (slot-ref down 'value) (slot-ref ctx 'volume-delta))))
(test* "C08 通常音符と集計" '(<sxmml-mml-note> 60 12 (((12 . 0)) ((12 . 1))))
       (let* ([ctx (make <sxmml-mml-context>)] [ir (sxmml-command-note! ctx 60 12)])
         (list (class-name (class-of ir)) (slot-ref ir 'value) (slot-ref ir 'ticks) (timing ctx))))
(test* "C09 休符と集計" '(<sxmml-mml-rest> #f 6 (((6 . 0)) ((6 . 1))))
       (let* ([ctx (make <sxmml-mml-context>)] [ir (sxmml-command-rest! ctx 6)])
         (list (class-name (class-of ir)) (slot-ref ir 'value) (slot-ref ir 'ticks) (timing ctx))))
(test* "C10 ポルタメントと集計" '(<sxmml-mml-portamento> (60 . 64) 18 (((18 . 0)) ((18 . 1))))
       (let* ([ctx (make <sxmml-mml-context>)] [ir (sxmml-command-portamento! ctx 60 64 18)])
         (list (class-name (class-of ir)) (slot-ref ir 'value) (slot-ref ir 'ticks) (timing ctx))))
(test* "C11 リズム発音と集計" '(<sxmml-rhythm-emit> #t (#t #t #f #f #f #f) 24 (((24 . 0)) ((24 . 1))))
       (let* ([ctx (make <sxmml-mml-context>)] [ir (sxmml-command-rhythm-on! ctx '(bass snare) 24)])
         (list (class-name (class-of ir)) (slot-ref ir 'value)
               (map (cut slot-ref ir <>) '(bass snare tom cymbal hihat rimshot))
               (slot-ref ir 'ticks) (timing ctx))))
(test* "C12 脱出なしの反復" '(<sxmml-mml-repeat-start> <sxmml-mml-repeat-end> 3 () (((42 . 0)) ((6 . 1) (12 . 1))))
       (let1 ctx (make <sxmml-mml-context>)
         (sxmml-command-note! ctx 60 6)
         (let1 start (sxmml-command-repeat-start! ctx)
           (sxmml-command-rest! ctx 12)
           (let1 end (sxmml-command-repeat-end! ctx 3)
             (list (class-name (class-of start)) (class-name (class-of end)) (slot-ref end 'value)
                   (slot-ref ctx 'repeat-stack) (timing ctx))))))
(test* "C13 脱出位置の復元" '(<sxmml-mml-repeat-break> 2 8 5 2 () (((36 . 0)) ((6 . 2) (12 . 1))))
       (let1 ctx (make <sxmml-mml-context>)
         (sxmml-command-note! ctx 60 6)
         (sxmml-command-repeat-start! ctx)
         (sxmml-command-default-length-set! ctx 8)
         (sxmml-command-octave-set! ctx 5)
         (sxmml-command-note-transpose-set! ctx 2)
         (sxmml-command-note! ctx 62 12)
         (let1 break (sxmml-command-repeat-break! ctx)
           (sxmml-command-default-length-set! ctx 16)
           (sxmml-command-octave-set! ctx 3)
           (sxmml-command-note-transpose-set! ctx 0)
           (sxmml-command-rest! ctx 6)
           (let1 end (sxmml-command-repeat-end! ctx 2)
             (list (class-name (class-of break)) (slot-ref end 'value)
                   (slot-ref ctx 'default-length) (slot-ref ctx 'current-octave)
                   (slot-ref ctx 'current-transpose) (slot-ref ctx 'repeat-stack) (timing ctx))))))
(test* "C14 ループ位置の記録" '(<sxmml-mml-loop> #t ((36 . 12)))
       (let1 ctx (make <sxmml-mml-context>)
         (sxmml-command-note! ctx 60 12)
         (let1 ir (sxmml-command-loop! ctx)
           (sxmml-command-rest! ctx 24)
           (list (class-name (class-of ir)) (slot-ref ctx 'loop-exists) (slot-ref ctx 'current-ticks)))))
(test* "C15 既定音長0" '(#t "invalid note length: 0 (expected an integer >= 1)")
       (value-error (^[] (sxmml-command-default-length-set! (make <sxmml-mml-context>) 0))))
(test* "C16 音長計算の分母0" '(#t "invalid note length: 0 (expected an integer >= 1)")
       (value-error (^[] (sxmml-command-note-length->ticks (make <sxmml-mml-context>) 24 0 0))))
(test* "C17 表せない付点" '(#t "number of dots exceeded resolution range")
       (value-error (^[] (sxmml-command-note-length->ticks (make <sxmml-mml-context>) 24 16 2))))
(test* "C18 反復内のL" '(#t "loop command cannot be used inside repeats")
       (value-error (^[] (let1 ctx (make <sxmml-mml-context>)
                          (sxmml-command-repeat-start! ctx) (sxmml-command-loop! ctx)))))
(test* "C19 Lの重複" '(#t "loop command can be used only once in a track")
       (value-error (^[] (let1 ctx (make <sxmml-mml-context>)
                          (sxmml-command-loop! ctx) (sxmml-command-loop! ctx)))))
(test* "C20 反復外の脱出" '(#t "break command cannot be used outside of repeats")
       (value-error (^[] (sxmml-command-repeat-break! (make <sxmml-mml-context>)))))
(test* "C21 脱出の重複" '(#t "break command can be used only once in a repeat")
       (value-error (^[] (let1 ctx (make <sxmml-mml-context>)
                          (sxmml-command-repeat-start! ctx)
                          (sxmml-command-repeat-break! ctx) (sxmml-command-repeat-break! ctx)))))
(test* "C22 開始前の反復終了" '(#t "repeat end appeared before repeat start")
       (value-error (^[] (sxmml-command-repeat-end! (make <sxmml-mml-context>) 1))))
(test* "C23 反復回数0" '(#t "invalid repeat count: 0 (expected a positive exact integer)")
       (value-error (^[] (let1 ctx (make <sxmml-mml-context>)
                          (sxmml-command-repeat-start! ctx) (sxmml-command-repeat-end! ctx 0)))))
(test* "C24 不正確な反復回数" '(#t "invalid repeat count: 2.0 (expected a positive exact integer)")
       (value-error (^[] (let1 ctx (make <sxmml-mml-context>)
                          (sxmml-command-repeat-start! ctx) (sxmml-command-repeat-end! ctx 2.0)))))
(test-end :exit-on-failure #t)
