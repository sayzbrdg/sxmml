# General info
SHELL       = @SHELL@
prefix      = @prefix@
exec_prefix = @exec_prefix@
bindir      = @bindir@
libdir      = @libdir@
datadir     = @datadir@
datarootdir = @datarootdir@
mandir      = @mandir@
srcdir      = @srcdir@
artifactdir = @ARTIFACT_DIR@
VPATH       = $(srcdir)

# These may be overridden by make invocators
DESTDIR        =
GOSH           = "@GOSH@"
GAUCHE_CONFIG  = "@GAUCHE_CONFIG@"
GAUCHE_PACKAGE = "@GAUCHE_PACKAGE@"
PANDOC         = @PANDOC@
INSTALL        = "@GAUCHE_INSTALL@" -C
CFLAGS         = @CFLAGS@
CPPFLAGS       = @CPPFLAGS@ @WINDOWS_UNICODE_FLAG@
LDFLAGS        = @LDFLAGS@
LIBS           = @LIBS@
SOEXT          = @SOEXT@
LOCAL_PATHS    = "@LOCAL_PATHS@"
TEST_ENV       = GAUCHE_DYNLOAD_PATH="$$(pwd)/$(artifactdir)$${GAUCHE_DYNLOAD_PATH:+:$$GAUCHE_DYNLOAD_PATH}" SXMML_SXLC=$(TARGET)

# Module-specific stuff
PACKAGE   = sxmml

TARGET    = $(artifactdir)/sxlc
ARCHFILES = $(artifactdir)/sxmml_native.$(SOEXT)
NATIVE_SRCS = sxmml_native.c sxmml_nativelib.scm sxmml_optimizerlib.scm sxmml_repeat_tree.c
MANPAGE   = sxlc.1
SCMFILES  = sxmml.scm sxmml/classes.scm sxmml/environment.scm sxmml/voice.scm sxmml/command.scm sxmml/mml.scm \
            sxmml/output.scm sxmml/compiler.scm sxmml/processor.scm sxmml/optimizer.scm sxmml/repeat-tree.scm \
            sxmml/util.scm sxmml/form.scm sxmml/backend/fmp7.scm sxmml/backend/fmp7-source.scm sxmml/backend/pmd.scm sxmml/backend/pmd-source.scm sxmml/backend/pmd-binary.scm sxmml/native.scm

GENERATED = $(MANPAGE)
CONFIG_GENERATED = Makefile config.cache config.log config.status \
		   configure.lineno autom4te*.cache $(PACKAGE).gpd

# 配置先の変数は configure で決まる本来のパスを持つ。DESTDIR は install・uninstall の
# 各コマンドで先頭に付ける (GNU Coding Standards の DESTDIR の慣例に従う)
GAUCHE_PKGINCDIR  = @GAUCHE_PKGINCDIR@
GAUCHE_PKGLIBDIR  = @GAUCHE_PKGLIBDIR@
GAUCHE_PKGARCHDIR = @GAUCHE_PKGARCHDIR@

all : $(TARGET) $(ARCHFILES)

$(ARCHFILES): $(srcdir)/src/lib/sxmml_native.c $(srcdir)/src/lib/sxmml_nativelib.scm $(srcdir)/src/lib/sxmml_optimizerlib.scm $(srcdir)/src/lib/sxmml_repeat_tree.c $(srcdir)/src/lib/sxmml_native.h $(srcdir)/src/lib/sxmml_repeat_tree.h
	@mkdir -p "$(artifactdir)"
	native_srcdir=$$(cd "$(srcdir)/src/lib" && pwd) && cd "$(artifactdir)" && \
	  $(GAUCHE_PACKAGE) compile --clean sxmml_native $(NATIVE_SRCS) && \
	  $(GAUCHE_PACKAGE) compile --srcdir="$$native_srcdir" \
	  --cppflags="$(CPPFLAGS)" --cflags="$(CFLAGS)" --ldflags="$(LDFLAGS)" \
	  --libs="$(LIBS)" --local=$(LOCAL_PATHS) --verbose sxmml_native $(NATIVE_SRCS)

# SXMML_SXLC でビルドした sxlc を検査対象に指定する。
# tools は配布物に含めないので、その検査は tools があるときだけ行う。
check : all
	@rm -f test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-helpers.scm" > test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-classes.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-command.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-output.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-compiler.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-environment.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-form.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-mml.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-ir-meaning.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-optimizer.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-pmd.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-fmp7.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-fmp7-source.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-processor.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-util.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-voice.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-sxlc.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-integration.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-sxmml.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-native.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-repeat-tree.scm" >> test.log
	$(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/test/test-pmd-binary.scm" >> test.log
	if test -f "$(srcdir)/tools/test-measure-optimize.scm"; then \
	  $(TEST_ENV) $(GOSH) -I. -I"$(srcdir)" "$(srcdir)/tools/test-measure-optimize.scm" >> test.log; \
	fi

# man ページは生成と配置を別の行にする。GNU make は MAKE 変数を含む行を
# make -n でも実行するため、配置を同じ行に書くと dry-run にならない
install : all
	$(INSTALL) -p "$(artifactdir)" -m 555 -T "$(DESTDIR)$(bindir)" $(TARGET)
	$(INSTALL) -S "$(srcdir)" -m 444 -T "$(DESTDIR)$(GAUCHE_PKGLIBDIR)" $(SCMFILES)
	$(INSTALL) -p "$(artifactdir)" -m 555 -T "$(DESTDIR)$(GAUCHE_PKGARCHDIR)" $(ARCHFILES)
	$(INSTALL) -m 444 -T "$(DESTDIR)$(GAUCHE_PKGLIBDIR)/.packages" $(PACKAGE).gpd
	@if test -n "$(PANDOC)"; then $(MAKE) $(MANPAGE); fi
	@if test -n "$(PANDOC)"; then \
	  set -x; $(INSTALL) -m 444 -T "$(DESTDIR)$(mandir)/man1" $(MANPAGE); \
	else \
	  echo "pandoc is not found; skip installing $(MANPAGE)"; \
	fi

uninstall :
	$(INSTALL) -U "$(DESTDIR)$(bindir)" sxlc
	$(INSTALL) -U "$(DESTDIR)$(GAUCHE_PKGLIBDIR)" $(SCMFILES)
	$(INSTALL) -U "$(DESTDIR)$(GAUCHE_PKGARCHDIR)" sxmml_native.$(SOEXT)
	$(INSTALL) -U "$(DESTDIR)$(GAUCHE_PKGLIBDIR)/.packages" $(PACKAGE).gpd
	$(INSTALL) -U "$(DESTDIR)$(mandir)/man1" $(MANPAGE)

clean :
	if test -d "$(artifactdir)"; then cd "$(artifactdir)" && $(GAUCHE_PACKAGE) compile --clean sxmml_native $(NATIVE_SRCS); fi
	rm -rf core $(TARGET) $(GENERATED) *~ test.log so_locations

distclean : clean
	rm -rf $(CONFIG_GENERATED)

maintainer-clean : clean
	rm -rf $(CONFIG_GENERATED)  VERSION

$(TARGET) : $(srcdir)/src/sxlc.in
	@mkdir -p "$(artifactdir)"
	@rm -f "$@"
	echo "#!$(GOSH)" > "$@" && \
	cat "$(srcdir)/src/sxlc.in" >> "$@"
	@chmod -w+x "$@"

man : $(MANPAGE)

$(MANPAGE) : doc/sxlc.1.md
	@if test -z "$(PANDOC)"; then \
	  echo "pandoc is not found; cannot generate $(MANPAGE)" >&2; exit 1; \
	fi
	$(PANDOC) --standalone --from=markdown --to=man $(srcdir)/doc/sxlc.1.md -o $(MANPAGE)


# Local variables:
# mode: Makefile
# end:
