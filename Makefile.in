# General info
SHELL       = @SHELL@
prefix      = @prefix@
exec_prefix = @exec_prefix@
bindir      = @bindir@
libdir      = @libdir@
datadir     = @datadir@
datarootdir = @datarootdir@
mandir      = @mandir@
srcdir      = @srcdir@
VPATH       = $(srcdir)

# These may be overridden by make invocators
DESTDIR        =
GOSH           = "@GOSH@"
GAUCHE_CONFIG  = "@GAUCHE_CONFIG@"
GAUCHE_PACKAGE = "@GAUCHE_PACKAGE@"
PANDOC         = @PANDOC@
INSTALL        = "@GAUCHE_INSTALL@" -S '$(srcdir)' -C

# Module-specific stuff
PACKAGE   = sxmml

TARGET    = sxlc
MANPAGE   = sxlc.1
SCMFILES  = sxmml.scm sxmml/classes.scm sxmml/environment.scm sxmml/voice.scm sxmml/mml.scm \
            sxmml/compiler.scm sxmml/processor.scm sxmml/optimizer.scm sxmml/repeat-tree.scm \
            sxmml/util.scm sxmml/form.scm sxmml/backend/pmd.scm sxmml/backend/pmd-binary.scm

GENERATED = $(MANPAGE)
CONFIG_GENERATED = Makefile config.cache config.log config.status \
		   configure.lineno autom4te*.cache $(PACKAGE).gpd

# 配置先の変数は configure で決まる本来のパスを持つ。DESTDIR は install・uninstall の
# 各コマンドで先頭に付ける (GNU Coding Standards の DESTDIR の慣例に従う)
GAUCHE_PKGINCDIR  = @GAUCHE_PKGINCDIR@
GAUCHE_PKGLIBDIR  = @GAUCHE_PKGLIBDIR@
GAUCHE_PKGARCHDIR = @GAUCHE_PKGARCHDIR@

all : $(TARGET)

# test-pmd-binary.scm には SXMML_SXLC で、PATH 上の別のインストールではなく
# ビルドした ./sxlc を検査させる。tools は配布物に含めないので、その検査は
# tools があるときだけ行う
check : all
	@rm -f test.log
	$(GOSH) -I. -I$(srcdir) $(srcdir)/test.scm > test.log
	$(GOSH) -I. -I$(srcdir) $(srcdir)/test-repeat-tree.scm >> test.log
	SXMML_SXLC=./sxlc $(GOSH) -I. -I$(srcdir) $(srcdir)/test-pmd-binary.scm >> test.log
	if test -f $(srcdir)/tools/test-measure-optimize.scm; then \
	  $(GOSH) -I. -I$(srcdir) $(srcdir)/tools/test-measure-optimize.scm >> test.log; \
	fi

# man ページは生成と配置を別の行にする。GNU make は MAKE 変数を含む行を
# make -n でも実行するため、配置を同じ行に書くと dry-run にならない
install : all
	$(INSTALL) -m 555 -T "$(DESTDIR)$(bindir)" $(TARGET)
	$(INSTALL) -m 444 -T "$(DESTDIR)$(GAUCHE_PKGLIBDIR)" $(SCMFILES)
	$(INSTALL) -m 444 -T "$(DESTDIR)$(GAUCHE_PKGLIBDIR)/.packages" $(PACKAGE).gpd
	@if test -n "$(PANDOC)"; then $(MAKE) $(MANPAGE); fi
	@if test -n "$(PANDOC)"; then \
	  set -x; $(INSTALL) -m 444 -T "$(DESTDIR)$(mandir)/man1" $(MANPAGE); \
	else \
	  echo "pandoc is not found; skip installing $(MANPAGE)"; \
	fi

uninstall :
	$(INSTALL) -U "$(DESTDIR)$(bindir)" $(TARGET)
	$(INSTALL) -U "$(DESTDIR)$(GAUCHE_PKGLIBDIR)" $(SCMFILES)
	$(INSTALL) -U "$(DESTDIR)$(GAUCHE_PKGLIBDIR)/.packages" $(PACKAGE).gpd
	$(INSTALL) -U "$(DESTDIR)$(mandir)/man1" $(MANPAGE)

clean :
	rm -rf core $(TARGET) $(GENERATED) *~ test.log so_locations

distclean : clean
	rm -rf $(CONFIG_GENERATED)

maintainer-clean : clean
	rm -rf $(CONFIG_GENERATED)  VERSION

sxlc : sxlc.in
	@rm -f sxlc
	echo "#!$(GOSH)" > sxlc && \
	cat $(srcdir)/sxlc.in >> sxlc
	@chmod -w+x sxlc

man : $(MANPAGE)

$(MANPAGE) : doc/sxlc.1.md
	@if test -z "$(PANDOC)"; then \
	  echo "pandoc is not found; cannot generate $(MANPAGE)" >&2; exit 1; \
	fi
	$(PANDOC) --standalone --from=markdown --to=man $(srcdir)/doc/sxlc.1.md -o $(MANPAGE)


# Local variables:
# mode: Makefile
# end:
